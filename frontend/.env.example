# Frontend Environment Variables Template
# Copy this file to .env or .env.local and populate with your environment values.
# NOTE: .env and .env.local are excluded by .gitignore and will never be pushed to Git.

# Base API URL pointing to the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api

# Backend Base URL (for OAuth2 redirect)
VITE_BACKEND_URL=http://localhost:8080

# Show demo login credentials one-click fill on /login
# Default is false. Set to 'true' only if you want demo accounts visible in development.
VITE_SHOW_DEMO=false
