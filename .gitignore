# ==========================================
# College Management System - Root .gitignore
# ==========================================

# Environment variables & Secret configurations (STRICTLY EXCLUDED)
.env
.env.*
!.env.example
!.env.*.example
*.env
application-local.properties
application-secret.properties
run-backend.bat
run-frontend.bat
backend/run-backend.bat

# ------------------------------------------
# Backend - Maven & Java build artifacts
# ------------------------------------------
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------
# Frontend - Node, Dependencies & Builds
# ------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
.eslintcache

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
.project
.classpath
.settings/
.springBeans
.sts4-cache/
bin/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# OS generated files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# Python & Scratch testing caches
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
